<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consolidated single project: the entire Saxon-HE 12.9 C# port as one physical source tree,
       one assembly. SDK-style glob compiles every **/*.cs, so folder layout is organisational only;
       namespaces stay Net.Sf.Saxon.* until phase R9 (a folder/namespace mismatch is expected in the
       interim). Subsystem folders (PascalCase, since R3): Api Collections Core Events Expressions
       Functions Hosting Json Model Patterns Regex Resources Serialization Text Tracing Transformation
       Trees Types Values XPath XQuery Xslt (+ Internal for low-level survivors as they land).
       Transitional folders scheduled to dissolve:
         compat/                            - Java stdlib shims over the .NET BCL (removed in R4)
         java/ javax/ jaxp/ stax/ dom/      - residual Java-package shims (per-file removal in R4)
         data/                              - embedded resources (DotNetPlatform.LocateResource); permanent -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Sole unsafe site: Internal/StackGuard.cs (address-of-local stack probe). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>OutSmart.DAXon</AssemblyName>
    <RootNamespace>OutSmart.DAXon</RootNamespace>
    <!-- CS0114 (hide-virtual-without-override) deliberately NOT suppressed: silent covariant/plain
         shadows of Java overrides were a recurring dispatch-bug family (R10 sweep closed 247). -->
    <NoWarn>CS0108;CS0252;CS0618;CS0649;CS1591;CS8073;CS0162;CS0219;CS0168;CS0414;CS0660;CS0661;CS1717;CS0628;CS0626;CS1574;CS1573;CS0419;CS1570</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Was false while the tree still carried transpiled Java: no hand-written AssemblyInfo.cs
         exists any more, so let the SDK stamp the identity below (previously shipped as 0.0.0.0). -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Assembly identity. AssemblyVersion is the binding identity: bump only on a breaking
         change, so consumers are not forced to re-bind on every patch. -->
    <Version>1.3.3</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.3.0</FileVersion>
    <!-- Derived from Version, not spelled out: a literal here silently went stale in 1.3.0. -->
    <InformationalVersion>$(Version) (port of Saxon-HE 12.9)</InformationalVersion>
    <!-- Off: the SDK would otherwise append the building repository's commit SHA to
         InformationalVersion, putting an internal revision id into a public artifact. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Outbridge</Authors>
    <Company>Outbridge</Company>
    <Product>OutSmart DAXon</Product>
    <Description>Native C# port of Saxon-HE 12.9: XSLT 3.0 / XPath 3.1 / XQuery 3.1 for .NET Framework 4.7.2+.</Description>
    <Copyright>Copyright (c) 2026 Outbridge; portions copyright (c) Saxonica Limited</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/outbridge-apps/DAXon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/outbridge-apps/DAXon</RepositoryUrl>
    <PackageTags>xslt xpath xquery xml transformation saxon xslt3 netframework net472</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Repo-root README ships inside the package (nuget.org package page renders it). -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- LogicalName pinned to the names the previous build produced (LocateResource matches by suffix,
         but keep them byte-stable anyway) -->
    <EmbeddedResource Include="data\casevariants.xml" LogicalName="Net.Sf.Saxon.casevariants.xml" />
    <EmbeddedResource Include="data\categories.xml" LogicalName="Net.Sf.Saxon.categories.xml" />
    <EmbeddedResource Include="data\unicodeBlocks.xml" LogicalName="Net.Sf.Saxon.unicodeBlocks.xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build-time only (PrivateAssets=All): supplies the net472 reference assemblies so the build
         does not depend on a locally installed 4.7.2 targeting pack. Nothing from it ships - the
         produced DLL is byte-identical with and without it (verified). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
